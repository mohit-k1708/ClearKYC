{
  "name": "clearkyc",
  "version": "1.0.0",
  "private": true,
  "description": "ClearKYC - Scene 1: Customer Onboarding (backend, Prisma schema and scripts live at the repo root; the React app lives in client/)",
  "main": "server/src/server.js",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "scripts": {
    "db:local": "node scripts/localPostgres.js",
    "db:migrate": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:backup": "node scripts/dbBackup.js backup",
    "db:backups": "node scripts/dbBackup.js list",
    "db:restore": "node scripts/dbBackup.js restore",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "seed:types": "node prisma/seed.js",
    "generate:customers": "node scripts/generateCustomers.js",
    "generate:kyc": "node scripts/generateKycData.js",
    "generate:ownership": "node scripts/generateOwnershipData.js",
    "generate:reviews": "node scripts/generateReviewData.js",
    "generate:scene5": "node scripts/generateScene5Data.js",
    "generate:starter": "node generator/index.js --scale=starter",
    "generate:medium": "node generator/index.js --scale=medium",
    "generate:full": "node generator/index.js --scale=full",
    "inject:edge-cases": "node generator/edgeCases/index.js",
    "detect:anomalies": "node detector/index.js",
    "evaluate:detection": "node evaluation/evaluateDetection.js",
    "label:existing": "node generator/edgeCases/labelExisting.js",
    "edge-cases:workflow": "node scripts/edgeCaseWorkflow.js",
    "validate:dataset": "node validation/index.js",
    "summarize:detection": "node packaging/finalDetectionSummary.js",
    "export:dataset": "node exporter/exportDataset.js",
    "verify:export": "node exporter/verifyExport.js",
    "generate:checksums": "node packaging/checksums.js",
    "verify:checksums": "node packaging/checksums.js --verify",
    "verify:package": "node packaging/verifyPackage.js",
    "test:reproducibility": "node reproducibility/runReproducibility.js",
    "package:dataset": "node packaging/packageDataset.js",
    "dataset:all": "node scripts/buildDataset.js",
    "test:phase4": "node --test --test-concurrency=1 server/tests/phase4.test.js",
    "test:edge-cases": "node --test --test-concurrency=1 server/tests/edgeCases.test.js",
    "start": "node server/src/server.js",
    "dev": "node --watch server/src/server.js",
    "test": "node scripts/withTestDatabase.js node --test --test-concurrency=1 \"server/tests/*.test.js\"",
    "perf:probe": "node scripts/perfProbe.js",
    "test:db:setup": "node scripts/testDatabase.js",
    "test:db:reset": "node scripts/testDatabase.js --recreate",
    "test:browser": "node scripts/runBrowserTests.js",
    "client": "npm --prefix client run dev"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "embedded-postgres": "^17.5.0-beta.15",
    "pg": "^8.16.0",
    "prisma": "^6.19.0",
    "puppeteer-core": "^25.16.0"
  }
}
