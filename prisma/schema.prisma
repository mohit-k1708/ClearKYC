// ClearKYC - Scene 1 (Customer Onboarding) database schema.
//
// Table names match the specification exactly: "CustomerType", "Customer", "RiskRating".
// The Prisma field names are camelCase; @map() keeps the real PostgreSQL columns snake_case.
//
// Extra database rules that Prisma cannot express (the Customer ID sequence and CHECK
// constraints) live in prisma/migrations/*_init/migration.sql.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Lookup table: "Individual" or "Company". One type has many customers.
model CustomerType {
  id        Int        @id @default(autoincrement())
  typeName  String     @unique @map("type_name")
  customers Customer[]

  // Scene 2
  kycRequirements KYCRequirement[]

  @@map("CustomerType")
}

model Customer {
  id Int @id @default(autoincrement())

  /// Business ID such as CUS-000001. Generated by the backend from the PostgreSQL
  /// sequence "customer_code_seq" (see migration) so it is never reused.
  customerCode String @unique @map("customer_id")

  customerTypeId Int          @map("customer_type_id")
  customerType   CustomerType @relation(fields: [customerTypeId], references: [id], onDelete: Restrict)

  /// Full name (Individual) or legal company name (Company).
  fullName String @map("full_name")
  email    String
  phone    String
  address  String
  /// ISO 3166-1 alpha-2 country code, e.g. "IN".
  country  String

  /// AES-256-GCM encrypted at application level. Never returned unmasked.
  panNumber     String  @map("pan_number")
  aadhaarNumber String? @map("aadhaar_number") // Individuals only

  /// HMAC-SHA256 "blind indexes" of the identifiers. They let the database enforce
  /// uniqueness (duplicate detection) without storing or searching plaintext.
  panHash     String  @unique @map("pan_hash")
  aadhaarHash String? @unique @map("aadhaar_hash")

  // Individual-only fields
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  occupation  String?

  // Company-only fields
  companyRegistrationNumber String?   @unique @map("company_registration_number")
  businessActivity          String?   @map("business_activity")
  dateOfIncorporation       DateTime? @map("date_of_incorporation") @db.Date

  /// Onboarding status only. This is NOT KYC completeness (out of scope for Scene 1).
  registrationStatus String @default("Registered") @map("registration_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  riskRatings RiskRating[]

  // Scene 2
  documents Document[]

  // Scene 3
  beneficialOwners     BeneficialOwner[]
  ownershipValidations OwnershipValidation[]

  // Scene 4
  exceptions      Exception[]
  reviewCases     ReviewCase[]
  reviewSchedules ReviewSchedule[]

  // Scene 5
  alerts Alert[]

  // Phase 2
  companyOwnerships CompanyOwnership[]

  // Phase 3
  onboardingDecisions OnboardingDecision[]

  @@index([customerTypeId])
  @@index([fullName])
  @@index([createdAt])
  @@map("Customer")
}

/// A customer can be assessed many times; the newest row is the "current" rating.
model RiskRating {
  id Int @id @default(autoincrement())

  customerId Int      @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  riskScore        Int      @map("risk_score")
  riskLevel        String   @map("risk_level") // Low | Medium | High
  /// JSON array of { factor, description, points, simulated } plus screening results.
  riskReasons      Json     @map("risk_reasons")
  assessmentDate   DateTime @default(now()) @map("assessment_date")
  assessmentMethod String   @map("assessment_method")
  createdAt        DateTime @default(now()) @map("created_at")

  // Scene 3 additions (all backwards compatible: Scene 1 inserts still work unchanged).
  /// Business ID such as RSK-000001, generated by the database sequence "risk_assessment_seq".
  assessmentCode    String    @unique @default(dbgenerated("next_risk_assessment_code()")) @map("assessment_code")
  /// The customer's risk level just before this assessment (null for the first rating).
  previousRiskLevel String?   @map("previous_risk_level")
  /// Who ran the assessment. Null = recorded by the system (Scene 1 onboarding).
  assessedById      Int?      @map("assessed_by_id")
  assessedBy        Reviewer? @relation("RiskAssessor", fields: [assessedById], references: [id], onDelete: Restrict)
  /// Completed | Requires Manual Review. risk_level stays Low/Medium/High (the score band).
  assessmentStatus  String    @default("Completed") @map("assessment_status")

  @@index([customerId, assessmentDate])
  @@index([riskLevel])
  @@index([assessmentStatus])
  @@map("RiskRating")
}

// =====================================================================================
// Scene 2: Document Management & Verification
//
// Extra rules Prisma cannot express (CHECK constraints, the immutable-history triggers and
// the "latest verification sets Document.status" trigger) live in
// prisma/migrations/*_scene2_documents/migration.sql.
// =====================================================================================

/// Which document a customer of a given type and risk level must provide.
/// These are configurable SAMPLE business rules, not universal regulatory requirements.
model KYCRequirement {
  id Int @id @default(autoincrement())

  customerTypeId Int          @map("customer_type_id")
  customerType   CustomerType @relation(fields: [customerTypeId], references: [id], onDelete: Restrict)

  riskLevel     String    @map("risk_level") // Low | Medium | High
  documentType  String    @map("document_type")
  isMandatory   Boolean   @default(true) @map("is_mandatory")
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  /// KYC-2026-000001. Filled by a database trigger when not supplied (year of effective_from).
  businessId String? @unique @map("business_id")

  documents Document[]

  @@unique([customerTypeId, riskLevel, documentType, effectiveFrom])
  @@index([customerTypeId, riskLevel, isActive])
  @@map("KYCRequirement")
}

/// People who can act in the review workflow. PROTOTYPE stand-in for real user accounts:
/// there is no login yet, so the acting reviewer is chosen by an X-Reviewer-Id header.
model Reviewer {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  role      String // Analyst | Reviewer | Admin  (only Reviewer and Admin may record decisions)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  verifications Verification[]

  // Scene 3
  riskAssessments RiskRating[]          @relation("RiskAssessor")
  ownersCreated   BeneficialOwner[]     @relation("OwnerCreator")
  ownersUpdated   BeneficialOwner[]     @relation("OwnerUpdater")
  ownerScreenings OwnerScreening[]
  ownershipChecks OwnershipValidation[]

  // Scene 4
  analystCases       ReviewCase[]     @relation("CaseAnalyst")
  reviewerCases      ReviewCase[]     @relation("CaseReviewer")
  casesCreated       ReviewCase[]     @relation("CaseCreator")
  casesProposed      ReviewCase[]     @relation("CaseProposer")
  caseHistory        CaseHistory[]
  caseNotes          CaseNote[]
  exceptionsResolved Exception[]      @relation("ExceptionResolver")
  schedulesCompleted ReviewSchedule[]

  // Scene 5
  auditEvents        AuditEvent[]
  alertsAcknowledged Alert[]         @relation("AlertAcknowledger")
  alertsResolved     Alert[]         @relation("AlertResolver")
  validationRuns     ValidationRun[]

  // Phase 3
  onboardingDecisions OnboardingDecision[]

  // Phase 6
  settingsChanged SystemSetting[]

  @@map("Reviewer")
}

/// A submitted document record. The FILE itself is never stored in PostgreSQL, only its
/// metadata and a storage reference.
model Document {
  id Int @id @default(autoincrement())

  customerId Int      @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  /// Requirement this document was submitted against (nullable: an extra document has none).
  requirementId Int?            @map("requirement_id")
  requirement   KYCRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)

  documentType String @map("document_type")

  /// SYNTHETIC document number, encrypted at application level (AES-256-GCM). Shown masked.
  documentNumber     String? @map("document_number")
  /// Keyed hash used only to detect an identical resubmission.
  documentNumberHash String? @map("document_number_hash")

  issueDate      DateTime  @map("issue_date") @db.Date
  expiryDate     DateTime? @map("expiry_date") @db.Date
  submissionDate DateTime  @map("submission_date") @db.Date
  notes          String?

  // File metadata. The file lives in the upload directory; fileReference is its generated name.
  fileReference    String? @map("file_reference")
  originalFileName String? @map("original_file_name")
  fileMimeType     String? @map("file_mime_type")
  fileSizeBytes    Int?    @map("file_size_bytes")

  /// Copy of the LATEST Verification.status. Kept in sync by a database trigger, so it can
  /// never disagree with the verification history.
  status String @default("Pending")

  /// DOC-CUS-000001-001. Filled by a database trigger when not supplied (a counter per customer).
  businessId String? @unique @map("business_id")

  /// Phase 3: the (synthetic) name that appears ON the document, compared with the customer's registered name. Empty = not captured.
  nameOnDocument String? @map("name_on_document")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  verifications Verification[]

  @@unique([customerId, documentType, documentNumberHash, issueDate, submissionDate])
  @@index([customerId])
  @@index([documentType])
  @@index([status])
  @@index([expiryDate])
  @@map("Document")
}

/// One review decision. Rows are INSERT-ONLY (triggers block UPDATE and DELETE): history is
/// never overwritten, and every new decision is a new row. The newest row is the current status.
model Verification {
  id Int @id @default(autoincrement())

  documentId Int      @map("document_id")
  document   Document @relation(fields: [documentId], references: [id], onDelete: Restrict)

  /// Null for system-created rows (the initial Pending record).
  reviewerId Int?      @map("reviewer_id")
  reviewer   Reviewer? @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  status           String // Pending | In Review | Verified | Rejected | Requires Resubmission
  remarks          String?
  verificationDate DateTime @default(now()) @map("verification_date")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([documentId, id])
  @@index([reviewerId])
  @@map("Verification")
}

// =====================================================================================
// Scene 3: Risk Assessment & Beneficial Ownership
//
// CHECK constraints, immutability triggers and the "owners belong to companies only" trigger
// live in prisma/migrations/*_scene3_ownership_risk/migration.sql.
// =====================================================================================

/// An individual who ultimately owns or controls a COMPANY customer (never an individual customer).
model BeneficialOwner {
  id Int @id @default(autoincrement())

  customerId Int      @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  fullName            String   @map("full_name")
  /// Date of birth (YYYY-MM-DD) is personal data, so it is encrypted at application level (AES-256-GCM).
  /// Null = not yet provided (counts as missing owner information).
  dateOfBirth         String?  @map("date_of_birth")
  /// ISO country codes. Null = missing information.
  countryOfResidence  String?  @map("country_of_residence")
  nationality         String?
  /// Null = missing percentage (the ownership total then cannot be reconciled).
  ownershipPercentage Decimal? @map("ownership_percentage") @db.Decimal(5, 2)
  ownershipType       String   @map("ownership_type") // Direct | Indirect
  controlType         String   @map("control_type")
  /// DECLARED PEP status (Yes | No | Unknown). Screening results are recorded separately.
  pepStatus           String   @default("Unknown") @map("pep_status")
  notes               String?

  /// Keyed hash of normalised name + date of birth; lets the database refuse an exact duplicate owner.
  identityHash String? @map("identity_hash")

  createdById Int?      @map("created_by_id")
  createdBy   Reviewer? @relation("OwnerCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById Int?      @map("updated_by_id")
  updatedBy   Reviewer? @relation("OwnerUpdater", fields: [updatedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  screenings OwnerScreening[]

  // Phase 2
  ownerships CompanyOwnership[]

  @@unique([customerId, identityHash])
  @@index([customerId])
  @@index([fullName])
  @@map("BeneficialOwner")
}

/// One screening outcome for one owner. INSERT-ONLY: a new screening is a new row, old rows are history.
/// There is no connection to any real PEP or sanctions database: outcomes are synthetic.
model OwnerScreening {
  id Int @id @default(autoincrement())

  beneficialOwnerId Int             @map("beneficial_owner_id")
  beneficialOwner   BeneficialOwner @relation(fields: [beneficialOwnerId], references: [id], onDelete: Cascade)

  screeningType   String  @map("screening_type") // PEP | Sanctions
  /// Confirmed | Potential Match | No Match. "Not Screened" is the absence of a row, never a stored value.
  screeningResult String  @map("screening_result")
  /// Points calculated by the server from the configured rules at the time of screening.
  riskPoints      Int     @map("risk_points")
  remarks         String?
  /// Simulated list match | Manual entry (synthetic)
  source          String

  screenedById Int?      @map("screened_by_id")
  screenedBy   Reviewer? @relation(fields: [screenedById], references: [id], onDelete: Restrict)
  screenedAt   DateTime  @default(now()) @map("screened_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([beneficialOwnerId, screeningType, id])
  @@map("OwnerScreening")
}

/// A recorded ownership reconciliation check. INSERT-ONLY history.
model OwnershipValidation {
  id Int @id @default(autoincrement())

  customerId Int      @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  totalOwnershipPercentage Decimal @map("total_ownership_percentage") @db.Decimal(7, 2)
  ownerCount               Int     @map("owner_count")
  /// RECONCILED | EXCEEDS_100 | BELOW_100 | NO_OWNERS | MISSING_PERCENTAGE
  validationStatus         String  @map("validation_status")
  validationMessage        String  @map("validation_message")

  checkedById Int?      @map("checked_by_id")
  checkedBy   Reviewer? @relation(fields: [checkedById], references: [id], onDelete: Restrict)
  checkedAt   DateTime  @default(now()) @map("checked_at")

  @@index([customerId, id])
  @@map("OwnershipValidation")
}

// =====================================================================================
// Scene 4: Review Cases & Exception Management
//
// CHECK constraints, partial unique indexes ("one ACTIVE exception per condition", "one active
// periodic case per customer and cycle", "one scheduled review per customer"), the insert-only
// history triggers and the resolved-exception lock live in
// prisma/migrations/*_scene4_review_cases/migration.sql.
// =====================================================================================

/// A condition that needs attention, DETECTED from real records (documents, ownership, risk, reviews).
/// Detection never creates a second active exception for the same condition. When the condition clears the
/// exception is resolved with a recorded resolution. Resolved exceptions are kept as history and never edited.
model Exception {
  id Int @id @default(autoincrement())

  /// EXC-000001 (database sequence)
  exceptionCode String @unique @default(dbgenerated("next_exception_code()")) @map("exception_code")

  customerId Int      @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  exceptionType String @map("exception_type")
  description   String
  severity      String // Low | Medium | High | Critical

  /// What caused it: Document | KYCRequirement | BeneficialOwner | Customer | ReviewSchedule | ReviewCase
  sourceEntityType String @map("source_entity_type")
  sourceEntityId   Int?   @map("source_entity_id")

  /// customer | type | source type | source id. Only one ACTIVE exception per key (partial unique index).
  dedupeKey String @map("dedupe_key")

  status     String    @default("Open") // Open | In Review | Resolved
  detectedAt DateTime  @default(now()) @map("detected_at")
  resolvedAt DateTime? @map("resolved_at")

  resolvedById    Int?      @map("resolved_by_id")
  resolvedBy      Reviewer? @relation("ExceptionResolver", fields: [resolvedById], references: [id], onDelete: Restrict)
  /// Condition cleared (found by detection) | Resolved manually (recorded by a person)
  resolutionType  String?   @map("resolution_type")
  resolutionNotes String?   @map("resolution_notes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cases  ReviewCase[]
  alerts Alert[]

  @@index([customerId, status])
  @@index([exceptionType, status])
  @@index([severity, status])
  @@index([dedupeKey])
  @@map("Exception")
}

/// A formal investigation or task. Status changes follow a backend-controlled workflow and every change is
/// recorded in CaseHistory. Cases are never deleted.
model ReviewCase {
  id Int @id @default(autoincrement())

  /// CASE-000001 (database sequence)
  caseCode String @unique @default(dbgenerated("next_review_case_code()")) @map("case_code")

  /// REV-CUS-000001-2026 (a customer's later cases in the same year get -02, -03). Filled by a trigger when not supplied.
  reviewCode String? @unique @map("review_code")

  customerId Int      @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// The exception this case investigates (null for a manually created case). One exception can have several cases over time.
  exceptionId Int?       @map("exception_id")
  exception   Exception? @relation(fields: [exceptionId], references: [id], onDelete: SetNull)

  /// Periodic KYC reviews: which schedule cycle this case belongs to (at most one active case per customer and cycle).
  reviewScheduleId Int?            @map("review_schedule_id")
  reviewSchedule   ReviewSchedule? @relation(fields: [reviewScheduleId], references: [id], onDelete: SetNull)
  periodicCycle    Int?            @map("periodic_cycle")

  caseTitle   String  @map("case_title")
  caseType    String  @map("case_type")
  description String?
  priority    String // Low | Medium | High | Critical

  assignedAnalystId  Int?      @map("assigned_analyst_id")
  assignedAnalyst    Reviewer? @relation("CaseAnalyst", fields: [assignedAnalystId], references: [id], onDelete: Restrict)
  assignedReviewerId Int?      @map("assigned_reviewer_id")
  assignedReviewer   Reviewer? @relation("CaseReviewer", fields: [assignedReviewerId], references: [id], onDelete: Restrict)

  status  String   @default("Open") // Open | Assigned | In Progress | Pending Customer | Escalated | Resolved | Closed
  dueDate DateTime @map("due_date") @db.Date

  resolutionNotes  String?   @map("resolution_notes")
  /// Compliance reviewer approval is needed before this case can be resolved (rules in config/reviewRules.js).
  requiresApproval Boolean   @default(false) @map("requires_approval")
  /// An analyst has proposed a resolution that is waiting for a reviewer to approve or reject it.
  proposalPending  Boolean   @default(false) @map("proposal_pending")
  proposedById     Int?      @map("proposed_by_id")
  proposedBy       Reviewer? @relation("CaseProposer", fields: [proposedById], references: [id], onDelete: Restrict)

  /// Null = created by the system (for example a periodic review that became due).
  createdById Int?      @map("created_by_id")
  createdBy   Reviewer? @relation("CaseCreator", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  resolvedAt DateTime? @map("resolved_at")
  closedAt   DateTime? @map("closed_at")

  history CaseHistory[]
  notes   CaseNote[]

  @@index([customerId, status])
  @@index([status, priority])
  @@index([assignedAnalystId, status])
  @@index([assignedReviewerId, status])
  @@index([dueDate])
  @@index([exceptionId])
  @@map("ReviewCase")
}

/// Every change to a case: creation, assignment, priority change, status change, reopening. INSERT-ONLY.
model CaseHistory {
  id Int @id @default(autoincrement())

  reviewCaseId Int        @map("review_case_id")
  reviewCase   ReviewCase @relation(fields: [reviewCaseId], references: [id], onDelete: Cascade)

  /// What happened, for example CREATED, ASSIGNED_ANALYST, STARTED, ESCALATED, APPROVED, REOPENED.
  action         String
  /// Null for the creation record. Equal to newStatus when the status did not change (assignment, priority).
  previousStatus String? @map("previous_status")
  newStatus      String  @map("new_status")

  /// Null = the system.
  changedById Int?      @map("changed_by_id")
  changedBy   Reviewer? @relation(fields: [changedById], references: [id], onDelete: Restrict)
  remarks     String?
  changedAt   DateTime  @default(now()) @map("changed_at")

  @@index([reviewCaseId, id])
  @@map("CaseHistory")
}

/// An internal investigation note. INSERT-ONLY.
model CaseNote {
  id Int @id @default(autoincrement())

  reviewCaseId Int        @map("review_case_id")
  reviewCase   ReviewCase @relation(fields: [reviewCaseId], references: [id], onDelete: Cascade)

  authorId  Int      @map("author_id")
  author    Reviewer @relation(fields: [authorId], references: [id], onDelete: Restrict)
  note      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([reviewCaseId, id])
  @@map("CaseNote")
}

/// When a customer next periodic KYC review is due. One row per review cycle: completing a review closes the
/// row (Completed) and starts the next (Scheduled), so a customer keeps their full schedule history.
/// The intervals per risk level are CONFIGURABLE illustrations (config/reviewRules.js), not legal requirements.
model ReviewSchedule {
  id Int @id @default(autoincrement())

  customerId Int      @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  cycleNumber          Int      @default(1) @map("cycle_number")
  riskLevel            String   @map("risk_level")
  lastReviewDate       DateTime @map("last_review_date") @db.Date
  nextReviewDate       DateTime @map("next_review_date") @db.Date
  reviewIntervalMonths Int      @map("review_interval_months")

  status String @default("Scheduled") // Scheduled | Completed | Superseded

  completedAt     DateTime? @map("completed_at")
  completedById   Int?      @map("completed_by_id")
  completedBy     Reviewer? @relation(fields: [completedById], references: [id], onDelete: Restrict)
  completionNotes String?   @map("completion_notes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cases ReviewCase[]

  @@index([customerId, status])
  @@index([status, nextReviewDate])
  @@map("ReviewSchedule")
}

// =====================================================================================
// Scene 5: Audit History, Alerts, Analytics & Final Reporting
//
// CHECK constraints, the partial unique index "one ACTIVE alert per condition", the insert-only
// audit trigger and the closed-alert guard live in prisma/migrations/*_scene5_audit_alerts/migration.sql.
// =====================================================================================

/// One important action in the KYC lifecycle. INSERT-ONLY: database triggers refuse UPDATE and DELETE, and the
/// application has no endpoint that changes or removes an audit event. Written by the backend in the SAME database
/// transaction as the business change it describes. Sensitive values (PAN, Aadhaar, document numbers, dates of birth,
/// secrets) are never stored: see services/auditService.js.
model AuditEvent {
  id Int @id @default(autoincrement())

  /// AUD-000001 (database sequence)
  eventCode String @unique @default(dbgenerated("next_audit_event_code()")) @map("event_code")

  /// Who did it. Null = the system (detection, seeding, automatic resolution).
  userId   Int?      @map("user_id")
  user     Reviewer? @relation(fields: [userId], references: [id], onDelete: Restrict)
  /// Role at the time of the action: Analyst | Reviewer | Admin | System (a snapshot, so later role changes never rewrite history).
  userRole String    @map("user_role")

  actionType String  @map("action_type")
  entityType String  @map("entity_type")
  entityId   Int?    @map("entity_id")
  /// Business reference of the entity, for example CUS-000001, CASE-000012, EXC-000003.
  entityRef  String? @map("entity_ref")
  /// The customer affected (no foreign key on purpose: the audit trail outlives any record it describes).
  customerId Int?    @map("customer_id")

  previousValues Json?   @map("previous_values")
  newValues      Json?   @map("new_values")
  reason         String?
  ipAddress      String? @map("ip_address")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([customerId, createdAt])
  @@index([actionType])
  @@index([userId])
  @@map("AuditEvent")
}

/// A notification about an important KYC condition, DERIVED from real records by the same detection run that creates
/// exceptions. Only one ACTIVE alert exists per condition (partial unique index). Alerts are resolved automatically when
/// the underlying condition clears, and are never deleted. History = the audit events of the alert.
model Alert {
  id Int @id @default(autoincrement())

  /// ALT-000001 (database sequence)
  alertCode String @unique @default(dbgenerated("next_alert_code()")) @map("alert_code")

  /// ALT-2026-000001 (counter per year). Filled by a trigger when not supplied.
  businessId String? @unique @map("business_id")
  /// Expiry alerts: the lead time in days (90, 60, 30 or 7) this alert is for. Empty for other alerts.
  threshold  Int?

  customerId Int      @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  alertType   String @map("alert_type")
  title       String
  description String
  severity    String // Low | Medium | High | Critical

  /// The record that caused the alert: Document | KYCRequirement | BeneficialOwner | Customer | ReviewSchedule
  relatedEntityType String     @map("related_entity_type")
  relatedEntityId   Int?       @map("related_entity_id")
  /// The exception detected from the same condition (null if the exception has been removed).
  exceptionId       Int?       @map("exception_id")
  exception         Exception? @relation(fields: [exceptionId], references: [id], onDelete: SetNull)

  /// The condition key shared with the exception engine. Only one ACTIVE alert per key.
  dedupeKey String @map("dedupe_key")

  status  String    @default("New") // New | Acknowledged | In Progress | Resolved | Dismissed
  dueDate DateTime? @map("due_date") @db.Date

  acknowledgedById Int?      @map("acknowledged_by_id")
  acknowledgedBy   Reviewer? @relation("AlertAcknowledger", fields: [acknowledgedById], references: [id], onDelete: Restrict)
  acknowledgedAt   DateTime? @map("acknowledged_at")

  resolvedById    Int?      @map("resolved_by_id")
  resolvedBy      Reviewer? @relation("AlertResolver", fields: [resolvedById], references: [id], onDelete: Restrict)
  resolvedAt      DateTime? @map("resolved_at")
  /// Condition cleared (the system) | Resolved manually | Dismissed manually
  resolutionType  String?   @map("resolution_type")
  resolutionNotes String?   @map("resolution_notes")

  /// True after a PERSON closed the alert while the condition still existed: detection then does not raise it again until the
  /// condition has cleared at least once.
  suppressRegeneration Boolean @default(false) @map("suppress_regeneration")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([customerId, status])
  @@index([alertType, status])
  @@index([severity, status])
  @@index([dedupeKey])
  @@index([createdAt])
  @@map("Alert")
}

/// One run of the data quality checks. The checks only READ business data: nothing is corrected silently.
model ValidationRun {
  id Int @id @default(autoincrement())

  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")
  /// The date the checks were evaluated for (overdue, expiry and review-date checks depend on it).
  asOf        DateTime  @map("as_of") @db.Date

  totalChecks  Int @default(0) @map("total_checks")
  passedChecks Int @default(0) @map("passed_checks")
  failedChecks Int @default(0) @map("failed_checks")
  warningCount Int @default(0) @map("warning_count")

  status String @default("Running") // Running | Completed | Failed

  /// One entry per check: { code, category, title, outcome: Passed|Failed|Warning, issueCount }.
  results Json @default("[]")

  createdById Int?      @map("created_by_id")
  createdBy   Reviewer? @relation(fields: [createdById], references: [id], onDelete: Restrict)

  issues ValidationIssue[]

  @@index([startedAt])
  @@map("ValidationRun")
}

/// A record that failed (or raised a warning on) a check, with a recommended fix. Issues are kept per run.
model ValidationIssue {
  id Int @id @default(autoincrement())

  validationRunId Int           @map("validation_run_id")
  validationRun   ValidationRun @relation(fields: [validationRunId], references: [id], onDelete: Restrict)

  checkCode  String  @map("check_code")
  category   String
  entityType String  @map("entity_type")
  entityId   Int?    @map("entity_id")
  entityRef  String? @map("entity_ref")
  /// The customer to open for investigation, when the issue belongs to one.
  customerId Int?    @map("customer_id")

  issueType      String @map("issue_type")
  severity       String // Error | Warning
  description    String
  recommendedFix String @map("recommended_fix")

  /// Open = still present in the newest run. Resolved = a later run no longer found it.
  status      String    @default("Open")
  resolvedAt  DateTime? @map("resolved_at")
  /// checkCode + entity, so the same problem can be recognised across runs.
  fingerprint String
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([validationRunId, severity])
  @@index([status, severity])
  @@index([fingerprint])
  @@map("ValidationIssue")
}

// =====================================================================================
// Phase 2: scoped ID counters and the company-owner bridge
// =====================================================================================

/// Gap-free counters behind the year- and customer-scoped business IDs (KYC-2026-..., ALT-2026-..., DOC-CUS-...-001, REV-...).
model IdCounter {
  scope     String
  period    Int    @default(0)
  lastValue Int    @default(0) @map("last_value")

  @@id([scope, period])
  @@map("IdCounter")
}

/// One company-owner relationship with its own percentage and effective dates. Mirrors BeneficialOwner automatically
/// (database triggers), so it can never disagree with the owner rows. person_ref groups the rows of the same person.
model CompanyOwnership {
  id Int @id @default(autoincrement())

  companyCustomerId Int             @map("company_customer_id")
  company           Customer        @relation(fields: [companyCustomerId], references: [id], onDelete: Cascade)
  beneficialOwnerId Int             @map("beneficial_owner_id")
  beneficialOwner   BeneficialOwner @relation(fields: [beneficialOwnerId], references: [id], onDelete: Cascade)

  personRef           String    @map("person_ref")
  ownershipPercentage Decimal?  @map("ownership_percentage") @db.Decimal(5, 2)
  ownershipType       String    @map("ownership_type")
  controlType         String    @map("control_type")
  effectiveFrom       DateTime  @map("effective_from") @db.Date
  effectiveTo         DateTime? @map("effective_to") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@index([companyCustomerId, effectiveTo])
  @@index([beneficialOwnerId])
  @@index([personRef])
  @@map("CompanyOwnership")
}

// =====================================================================================
// Phase 3: onboarding decisions
// INSERT-ONLY (triggers refuse UPDATE and DELETE); the newest row is the customer's current decision.
// =====================================================================================

/// Whether a customer was approved, rejected or left pending review, with who decided and when.
model OnboardingDecision {
  id Int @id @default(autoincrement())

  customerId Int      @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// Approved | Rejected | Pending Review
  decision    String
  decidedById Int      @map("decided_by_id")
  decidedBy   Reviewer @relation(fields: [decidedById], references: [id], onDelete: Restrict)
  decidedAt   DateTime @default(now()) @map("decided_at")
  notes       String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([customerId, decidedAt])
  @@map("OnboardingDecision")
}

// =====================================================================================
// Phase 6: system settings (versioned, insert-only)
// =====================================================================================

/// One change of a setting. The newest row of a key is its current value; older rows are the history.
model SystemSetting {
  id Int @id @default(autoincrement())

  /// expiry_alert_days: the document-expiry alert lead times, largest first, for example [90, 60, 30, 7].
  key         String
  value       Json
  changedById Int      @map("changed_by_id")
  changedBy   Reviewer @relation(fields: [changedById], references: [id], onDelete: Restrict)
  reason      String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([key, id])
  @@map("SystemSetting")
}
